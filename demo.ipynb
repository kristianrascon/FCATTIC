# Chat Simulation Notebook - Inspired by Erica

import ipywidgets as widgets
from IPython.display import display, clear_output
import time

# Predefined script (user and bot alternate messages)
conversation_script = [
    ("user", "Hi Erica, what's my account balance?"),
    ("bot", "Sure, let me check that for you."),
    ("bot", "Your checking account balance is $2,345.67."),
    ("user", "Thanks! Can you show me recent transactions?"),
    ("bot", "Here are your last 3 transactions:"),
    ("bot", "1. Starbucks - $5.45\n2. Amazon - $23.99\n3. Payroll Deposit +$1,200.00"),
    ("user", "Great, set a reminder to pay rent on the 1st."),
    ("bot", "Got it! I’ll remind you to pay rent on the 1st of each month."),
]

# Widgets
chat_box = widgets.HTML(value="<b>Erica Assistant</b><br><hr>")
user_input = widgets.Text(placeholder='Type here...', disabled=True)
send_button = widgets.Button(description="Send", disabled=True)

# Displayed messages
chat_history = []

def render_chat():
    html_content = "<style>.chat-bubble {padding: 8px; border-radius: 10px; margin: 5px 0; max-width: 80%;} .user {background-color:#d1e7dd; align-self: flex-end;} .bot {background-color:#f8f9fa;}</style>"
    html_content += "<div style='display:flex; flex-direction:column;'>"
    for sender, message in chat_history:
        bubble_class = 'user' if sender == 'user' else 'bot'
        html_content += f"<div class='chat-bubble {bubble_class}'><b>{'You' if sender == 'user' else 'Erica'}:</b><br>{message}</div>"
    html_content += "</div>"
    chat_box.value = html_content

# Index to track script progression
script_index = 0

def next_script_message(_=None):
    global script_index
    if script_index < len(conversation_script):
        sender, message = conversation_script[script_index]
        chat_history.append((sender, message))
        script_index += 1
        render_chat()
        # If the next line is also from the bot, auto-advance after a short delay
        if script_index < len(conversation_script) and conversation_script[script_index][0] == "bot":
            time.sleep(1)
            next_script_message()

# Kick off the conversation
start_button = widgets.Button(description="Start Chat")

def on_start_click(_):
    start_button.disabled = True
    next_script_message()

start_button.on_click(on_start_click)

# Display UI
display(chat_box)
display(start_button)
