import ipywidgets as widgets
from IPython.display import display, clear_output

# Predefined conversation script
conversation_script = [
    ("user", "Hi Erica, what's my account balance?"),
    ("bot", "Sure, let me check that for you."),
    ("bot", "Your checking account balance is $2,345.67."),
    ("user", "Thanks! Can you show me recent transactions?"),
    ("bot", "Here are your last 3 transactions:"),
    ("bot", "1. Starbucks - $5.45\n2. Amazon - $23.99\n3. Payroll Deposit +$1,200.00"),
    ("user", "Great, set a reminder to pay rent on the 1st."),
    ("bot", "Got it! I’ll remind you to pay rent on the 1st of each month."),
]

# UI widgets
chat_box = widgets.HTML()
next_button = widgets.Button(description="Next")

# Internal state
chat_history = []
script_index = 0

def render_chat():
    html_content = """
    <style>
    .chat-bubble {
        padding: 8px;
        border-radius: 10px;
        margin: 5px 0;
        max-width: 80%;
        font-family: Arial, sans-serif;
    }
    .user {
        background-color: #d1e7dd;
        color: #0a3622;
        align-self: flex-end;
    }
    .bot {
        background-color: #f8f9fa;
        color: #084298;
    }
    </style>
    """
    html_content += "<div style='display:flex; flex-direction:column;'>"
    for sender, message in chat_history:
        bubble_class = 'user' if sender == 'user' else 'bot'
        label = 'You' if sender == 'user' else 'Erica'
        html_content += f"<div class='chat-bubble {bubble_class}'><b>{label}:</b><br>{message}</div>"
    html_content += "</div>"
    chat_box.value = html_content

def on_next_click(_):
    global script_index
    if script_index < len(conversation_script):
        sender, message = conversation_script[script_index]
        chat_history.append((sender, message))
        script_index += 1
        render_chat()
    else:
        next_button.disabled = True

# Connect button
next_button.on_click(on_next_click)

# Display chat and button
display(chat_box)
display(next_button)
